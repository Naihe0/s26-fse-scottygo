{
  "name": "scottygo",
  "author": "",
  "contributors": [
    "George A Stey",
    "Anthony Ren",
    "Charlie Ai",
    "Ningrui Yang"
  ],
  "license": "BSD-3-Clause",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmu-fse/s26-fse-scottygo.git"
  },
  "scripts": {
    "clean:dist": "node tools/clean.mjs",
    "clean:all": "node tools/clean.mjs --all",
    "build": "parcel build",
    "clean:build": "npm-run-all clean:all build",
    "start": "node --max-old-space-size=320 --expose-gc ./.dist/server/serve",
    "local:start": "powershell -NoProfile -File ./tools/local.ps1 -Action start",
    "local:stop": "powershell -NoProfile -File ./tools/local.ps1 -Action stop",
    "local:status": "powershell -NoProfile -File ./tools/local.ps1 -Action status",
    "watch": "nodemon --watch client --watch server --watch .env -e js,ts,html,css,json --exec npm-run-all build start",
    "lint": "eslint ./",
    "export:cmu-static": "ts-node ./tools/export-cmu-static-from-tripshot",
    "serve": "ts-node server/serve",
    "test": "jest",
    "test:rest": "jest tests/server.tests/rest.tests --runInBand --detectOpenHandles --coverageDirectory=.coverage/rest",
    "test:rest:e2e": "npm-run-all --continue-on-error test:rest:e2e:transitAPI",
    "test:rest:manageacct": "jest ./tests/server.tests/rest.tests/manageacct.rest.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/rest-manageacct",
    "test:rest:memory-monitoring": "jest ./tests/server.tests/rest.tests/memory-monitoring.rest.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/rest-memory-monitoring",
    "test:rest:transit": "jest ./tests/server.tests/rest.tests/transit.rest.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/rest-transit",
    "test:rest:transitAPI": "jest ./tests/server.tests/rest.tests/transitAPI.rest.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/rest-transitAPI",
    "test:rest:e2e:transitAPI": "node tools/transit-e2e.mjs",
    "test:rest:loginlogout": "jest ./tests/server.tests/rest.tests/loginlogout.rest.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/rest-loginlogout",
    "test:unit:loginlogout": "jest ./tests/server.tests/unit.tests/loginlogout.unit.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/unit-loginlogout",
    "test:unit:manageacct": "jest ./tests/server.tests/unit.tests/manageacct.unit.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/unit-manageacct",
    "test:unit:register": "jest ./tests/server.tests/unit.tests/register.unit.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/unit-register",
    "test:unit:searchinfo": "jest ./tests/server.tests/unit.tests/searchinfo.unit.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/unit-searchinfo",
    "test:unit:track-bus": "jest ./tests/server.tests/unit.tests/track-bus.unit.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/unit-track-bus",
    "test:unit:visualize-routes": "jest ./tests/server.tests/unit.tests/tuc1-visualize-routes.unit.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/unit-visualize-routes",
    "test:unit:discoverstops": "jest ./tests/server.tests/unit.tests/discoverstops.unit.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/unit-discoverstops",
    "test:unit:bootstrap": "jest ./tests/server.tests/unit.tests/admin-bootstrap.unit.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/unit-bootstrap",
    "test:unit:directions": "jest ./tests/client.tests --runInBand --detectOpenHandles --coverageDirectory=.coverage/unit-directions",
    "test:unit": "jest tests/server.tests/unit.tests tests/client.tests --runInBand --detectOpenHandles --coverageDirectory=.coverage/unit",
    "test:integration:manageacct": "jest ./tests/server.tests/integration.tests/manageacct.integration.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/integration-manageacct",
    "test:integration:loginlogout": "jest ./tests/server.tests/integration.tests/loginlogout.integration.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/integration-loginlogout",
    "test:integration": "jest tests/server.tests/integration.tests --runInBand --detectOpenHandles --coverageDirectory=.coverage/integration",
    "test:integration:register": "jest ./tests/server.tests/integration.tests/register.integration.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/integration-register",
    "test:integration:searchinfo": "jest ./tests/server.tests/integration.tests/searchinfo.integration.test.ts --runInBand --detectOpenHandles --coverageDirectory=.coverage/integration-searchinfo",
    "test:integration:visualize-routes": "jest ./tests/server.tests/integration.tests/visualize-routes.integration.test.ts --runInBand --detectOpenHandles --forceExit --coverageDirectory=.coverage/integration-visualize-routes",
    "test:integration:trackBus": "jest ./tests/server.tests/integration.tests/trackBus.integration.test.ts --runInBand --detectOpenHandles --forceExit --coverageDirectory=.coverage/integration-trackBus",
    "test:integration:livenotification": "jest ./tests/server.tests/integration.tests/livenotification.integration.test.ts --runInBand --detectOpenHandles --forceExit --coverageDirectory=.coverage/integration-livenotification",
    "test:integration:discover-stops": "jest ./tests/server.tests/integration.tests/discover-stops.integration.test.ts --runInBand --detectOpenHandles --forceExit --coverageDirectory=.coverage/integration-discover-stops",
    "test:server": "npm-run-all --continue-on-error test:unit test:integration test:rest",
    "prepush:check": "node ./tools/prepush-safety-check.mjs",
    "check:paths": "node tools/check-paths.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test:ci": "jest --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "gtfs-realtime-bindings": "^1.1.1",
    "jquery": "^3.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@parcel/watcher": "^2.4.1",
    "@tsconfig/node-lts": "^20.1.3",
    "@types/adm-zip": "^0.5.7",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/google.maps": "^3.58.1",
    "@types/http-terminator": "^2.0.5",
    "@types/jest": "^29.5.12",
    "@types/jquery": "^3.5.30",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.12",
    "adm-zip": "^0.6.1",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "eslint": "^9.8.0",
    "globals": "^15.9.0",
    "http-terminator": "^3.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-expect-message": "^1.1.3",
    "nodemon": "^3.1.4",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.12.0",
    "prettier": "^3.3.3",
    "process": "^0.11.10",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1",
    "url": "^0.11.3",
    "util": "^0.12.5"
  },
  "targets": {
    "client": {
      "source": [
        "client/pages/auth.html",
        "client/pages/map.html",
        "client/pages/account.html",
        "client/pages/notifications.html",
        "client/pages/subscriptions.html"
      ],
      "distDir": ".dist/client",
      "context": "browser"
    },
    "server": {
      "source": "server/serve.ts",
      "distDir": ".dist/server",
      "context": "node",
      "includeNodeModules": false
    }
  },
  "engines": {
    "node": "^24.19.0",
    "npm": ">=10.8.0"
  }
}
