# Copy to .env; never commit credentials. Local defaults use a persistent DB.
ENV=LOCAL
STAGE=DEV
ALLOW_DB_RESET=false
BIND_ADDRESS=127.0.0.1
PORT=8080
LOCAL_HOST=http://localhost
CODESPACE_HOST=
RENDER_HOST=

DB_URL=mongodb://127.0.0.1:27017
DEV_DB=/ScottyGoLocal
PROD_DB=/ScottyGoPROD?retryWrites=true&w=majority
# Jest accepts only loopback MongoDB and database scottygo_test or scottygo_test_*.
TEST_DB_URL=mongodb://127.0.0.1:27019/scottygo_test

# Generate private random values. PROD requires JWT >=32 chars and admin >=12.
# INITIAL_ADMIN_PASSWORD only seeds a missing admin; it never resets one.
JWT_KEY=
INITIAL_ADMIN_PASSWORD=
JWT_EXP=7d

# Google Maps JavaScript, Places, and Routes APIs; restrict to your app hosts.
GOOGLE_MAPS_KEY=

# Optional PRT TrueTime key (live GTFS and CMU feeds do not need credentials).
TRUETIME_KEY=
TRUETIME_BASE_URL=https://truetime.portauthority.org/bustime/api/v3

# Optional Brevo account-status emails; EMAIL_USER must be a verified sender.
BREVO_API_KEY=
EMAIL_USER=
EMAIL_FROM_NAME=ScottyGO

# Optional AI moderation; without a key the app uses its local keyword filter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
